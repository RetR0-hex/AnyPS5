#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform image2DMS surface;
layout(set = 0, binding = 1, std430) buffer GuestBytes { uint texels[]; };
layout(push_constant) uniform Parameters {
    uint width;
    uint height;
    uint samples;
    uint toImage;
    uint blockWidth;
    uint blockHeight;
    uint masks[16];
} p;

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= p.width || pixel.y >= p.height) return;
    uint blocksPerRow = (p.width + p.blockWidth - 1) / p.blockWidth;
    uint block = pixel.y / p.blockHeight * blocksPerRow + pixel.x / p.blockWidth;
    for (uint sampleIndex = 0; sampleIndex < p.samples; ++sampleIndex) {
        // Include high block-coordinate bits in the pipe XOR; clipping coordinates to a tile
        // would transpose samples at block boundaries. Unused high bits are masked before packing.
        uint coordinate = (pixel.x & 0xfffu) | ((pixel.y & 0xfffu) << 12) | (sampleIndex << 24);
        uint offset = 0;
        for (uint bit = 0; bit < 16; ++bit) offset |= (bitCount(coordinate & p.masks[bit]) & 1u) << bit;
        uint index = block * 16384 + offset / 4;
        if (p.toImage != 0) imageStore(surface, ivec2(pixel), int(sampleIndex), unpackUnorm4x8(texels[index]));
        else texels[index] = packUnorm4x8(imageLoad(surface, ivec2(pixel), int(sampleIndex)));
    }
}
